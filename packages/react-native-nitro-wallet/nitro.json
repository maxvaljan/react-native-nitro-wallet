{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "nitrowallet"
  ],
  "ios": {
    "iosModuleName": "NitroWallet"
  },
  "android": {
    "androidNamespace": [
      "nitrowallet"
    ],
    "androidCxxLibName": "NitroWallet"
  },
  "autolinking": {
    "Wallet": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridWallet"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridWallet"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules"
  ]
}
