{
  "name": "react-native-nitro-wallet",
  "version": "0.0.1",
  "description": "React Native Nitro Module for Apple Wallet passes and Google Wallet save flows.",
  "main": "lib/index",
  "module": "lib/index",
  "types": "lib/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "react-native.config.js",
    "lib",
    "app.plugin.js",
    "plugin/build",
    "nitrogen",
    "android/build.gradle",
    "android/gradle.properties",
    "android/fix-prefab.gradle",
    "android/CMakeLists.txt",
    "android/src",
    "ios/**/*.h",
    "ios/**/*.m",
    "ios/**/*.mm",
    "ios/**/*.cpp",
    "ios/**/*.swift",
    "nitro.json",
    "*.podspec",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:plugin": "tsc -p plugin/tsconfig.json",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf android/build node_modules/**/android/build lib plugin/build",
    "lint": "eslint \"**/*.{js,ts,tsx}\" --fix",
    "lint-ci": "eslint \"**/*.{js,ts,tsx}\" -f @jamesacarr/github-actions --max-warnings 0",
    "typescript": "tsc",
    "pack:dry-run": "bun run build:plugin && bun pm pack --dry-run",
    "release": "release-it",
    "specs": "tsc --noEmit false && nitrogen --logLevel=\"debug\"",
    "test": "bun run build:plugin && bun test"
  },
  "keywords": [
    "react-native",
    "nitro",
    "nitro-modules",
    "apple-wallet",
    "google-wallet",
    "passkit",
    "wallet"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxvaljan/react-native-nitro-wallet.git"
  },
  "author": "Supa",
  "license": "MIT",
  "homepage": "https://github.com/maxvaljan/react-native-nitro-wallet#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@jamesacarr/eslint-formatter-github-actions": "^0.2.0",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/eslint-config": "0.85.3",
    "@react-native/eslint-plugin": "0.85.3",
    "@types/react": "^19.2.15",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-ft-flow": "^2.0.1",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "expo": "^56.0.9",
    "nitrogen": "*",
    "prettier": "^3.8.3",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-nitro-modules": "0.35.9",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.75",
    "react-native-nitro-modules": ">=0.35.0 <0.36.0",
    "expo": "*"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native",
      "prettier"
    ],
    "plugins": [
      "prettier"
    ],
    "rules": {
      "prettier/prettier": [
        "warn",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/",
    "plugin/build/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false,
    "semi": false
  }
}
